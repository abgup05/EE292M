# Copy to .env (gitignored) and fill in what you have. Every value is optional.

# Without ANTHROPIC_API_KEY the app uses the deterministic extractive engine: it quotes the
# sentences that best match each claim but judges no stance, so no claim is "supported".
ANTHROPIC_API_KEY=
# The Claude model used for planning, assessment and the summary when the key is set.
ANTHROPIC_MODEL=claude-opus-5-5
# The model that checks each verified finding's meaning (a second reading of the excerpts).
# With the key set and this empty, claude-haiku-5-5 is used. The same model as ANTHROPIC_MODEL
# is allowed but recorded as a coverage limit: it is not an independent reading.
ANTHROPIC_CHECK_MODEL=

# A second reader of each claim's computed test (docs/claim-tests.md). Empty or "grammar":
# the grammar reads every claim alone, and nothing is asked of a model. "model": a model also
# reads each claim's test (one request per claim, step "read", through the same API key or
# cassette as the engine), and a computed test counts toward a verdict only when the grammar
# and the model read the same test; otherwise both readings are shown and it is not counted.
EVIDENCE_DESK_CLAIM_READER=
# The model that reads the claims when EVIDENCE_DESK_CLAIM_READER=model. Empty: claude-haiku-5-5.
ANTHROPIC_READER_MODEL=

# SEC EDGAR asks automated clients to identify themselves in the User-Agent header,
# with a name and a contact email, for example "Example Research ops@example.com".
# When this is empty a generic Evidence Desk identifier is sent.
SEC_USER_AGENT=

# Record and replay of model answers (docs/cassettes.md). EVIDENCE_DESK_CASSETTE names a
# cassette directory, for example cassettes/nvda-example: the Claude engine then answers
# from its recorded responses, and saves any request it lacks under <dir>/pending instead of
# calling the API. Set EVIDENCE_DESK_CASSETTE_RECORD=1 (with ANTHROPIC_API_KEY) to send the
# missing requests to the Anthropic API and record the answers. A cassette stores answers
# and who produced them, never a key or a header.
EVIDENCE_DESK_CASSETTE=
EVIDENCE_DESK_CASSETTE_RECORD=
