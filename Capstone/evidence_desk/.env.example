# Copy to .env (gitignored). Both credentials are optional.
# Without ANTHROPIC_API_KEY the app uses a deterministic extractive synthesizer.
ANTHROPIC_API_KEY=
# Claude model used for planning and synthesis when the key above is set.
ANTHROPIC_MODEL=claude-opus-5-5
# Without BRAVE_SEARCH_API_KEY runs use seed URLs only and record the coverage limit.
BRAVE_SEARCH_API_KEY=
