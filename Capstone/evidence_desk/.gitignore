# Version 3's database: left alone, never read (see src/app/wiring.py).
data/runs/**
!data/runs/.gitkeep
# The record (back it up with `make backup`), the disposable filing cache and fact store.
data/record/**
!data/record/.gitkeep
data/cache/**
!data/cache/.gitkeep
data/facts/**
!data/facts/.gitkeep
backups/**
!backups/.gitkeep
results/**
!results/.gitkeep
# Requests a cassette could not answer: work in progress, never committed.
demo/cassettes/*/pending/
eval/cassettes/*/pending/
